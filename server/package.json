{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write resources/js resources/css vite.config.js",
    "format:check": "prettier --check resources/js resources/css vite.config.js",
    "test:browser": "playwright test",
    "test:frontend": "node resources/js/shared/studioSelection.test.mjs",
    "test:render": "node tests/Render/pages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.3.14",
    "@css-render/vue3-ssr": "0.15.14",
    "@prettier/plugin-php": "^0.22.4"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.11.0",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.45"
  }
}
