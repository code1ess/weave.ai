{
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "plugins": [
    "@prettier/plugin-php"
  ],
  "overrides": [
    {
      "files": "**/*.php",
      "options": {
        "tabWidth": 2,
        "useTabs": false,
        "singleQuote": false,
        "braceStyle": "per-cs",
        "printWidth": 140
      }
    }
  ]
}
